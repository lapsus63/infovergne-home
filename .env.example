# Database Configuration
POSTGRES_DB=infovergne
POSTGRES_USER=infovergne
POSTGRES_PASSWORD=changeme_secure_password_here

# Keycloak Configuration (connexion à instance existante)
KEYCLOAK_AUTH_URL=http://your-keycloak-host:8083
KEYCLOAK_REALM=infovergne
KEYCLOAK_CLIENT_ID=infovergne-home
KEYCLOAK_JWK_URI=http://your-keycloak-host:8083/realms/infovergne/protocol/openid-connect/certs
KEYCLOAK_ISSUER_URI=http://your-keycloak-host:8083/realms/infovergne

# Clé partagée entre le site et l'agent Docker (générer avec openssl rand -hex 32)
AGENT_KEY=replace-with-a-random-secret

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Les valeurs VITE* sont baked in au build, pas injectées au runtime.
VITE_API_URL=http://localhost:8080/api
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=infovergne
VITE_KEYCLOAK_CLIENT_ID=infovergne-home

# Backend Memory
BACKEND_MEMORY=512m
