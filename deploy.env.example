# Configuration de déploiement pour Infovergne Home
# Copier ce fichier en deploy.env et adapter les valeurs

# Répertoire cible du déploiement (où seront copiés les artefacts)
TARGET_DIR=/opt/infovergne-home

# Répertoire contenant docker-compose.yml (peut être le même que TARGET_DIR)
COMPOSE_DIR=/opt/infovergne-home

# Options de déploiement (si non définies, le script demandera interactivement)
# UPDATE_DB_SCHEMA=false
# RESTART_DOCKER=false
